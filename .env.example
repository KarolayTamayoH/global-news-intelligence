# Copiar a .env, editar y cargar desde la raiz:
# set -a
# source .env
# set +a
# Python lee variables del proceso; Compose lee .env automaticamente.
MONGO_URI=mongodb://127.0.0.1:27018/
MONGO_DATABASE=global_news
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9043
CASSANDRA_KEYSPACE=global_news_analytics
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=CAMBIAR_CLAVE_LOCAL
NEO4J_DATABASE=neo4j
GNI_DATA_DIR=data
# Puertos publicados por Compose; si se cambian, ajustar tambien los URI anteriores.
MONGO_PORT=27018
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
# Serie de imagen compatible; se pueden reemplazar por tags exactos o digests.
MONGO_IMAGE=mongo:8.0
CASSANDRA_IMAGE=cassandra:5.0
NEO4J_IMAGE=neo4j:5.26-community
