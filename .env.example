# Copiar a .env y editar los valores locales.
MONGO_URI=mongodb://127.0.0.1:27018/
MONGO_DATABASE=global_news
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9043
CASSANDRA_KEYSPACE=global_news_analytics
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_DATABASE=neo4j
GNI_DATA_DIR=data

# Puertos publicados por Compose; si se cambian, ajustar tambien los URI anteriores.
MONGO_PORT=27018
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688

# Entrega local: Compose usa file:///opt/gni/data; terminal usa GNI_DATA_DIR.
# GNI_ARTIFACT_URI=file:///ruta/absoluta/data
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=contraseña
AIRFLOW_IMAGE=apache/airflow:2.11.1-python3.12
AIRFLOW_PORT=8080
